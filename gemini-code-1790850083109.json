son.output.rating }} </td>\n      </tr>\n\n<tr style=\"border-bottom: 1px solid #f1f5f9;\">\n        <td style=\"padding: 12px 16px; font-weight: bold; color: #475569;\">Phone:</td>\n      </tr>\n\n    </table>\n\n    <!-- AI Analysis Section -->\n    <div style=\"background-color: #ffffff; border-radius: 8px; padding: 18px; border: 1px solid #e2e8f0;\">\n      <h3 style=\"margin-top: 0; color: #1e293b; font-size: 16px; border-bottom: 2px solid #3b82f6; display: inline-block; padding-bottom: 4px;\">🧠 AI Lead Analysis</h3>\n      \n      <div style=\"margin-top: 12px;\">\n        <p style=\"margin: 0 0 6px 0; font-size: 13px; font-weight: bold; color: #64748b; text-transform: uppercase;\">Evaluation Reason</p>\n        <p style=\"margin: 0 0 16px 0; color: #334155; font-size: 14px; line-height: 1.5;\">{{ $json['Bussiness Details'].reason }}</p>\n      </div>\n\n      <div style=\"margin-top: 12px;\">\n        <p style=\"margin: 0 0 6px 0; font-size: 13px; font-weight: bold; color: #64748b; text-transform: uppercase;\">Potential Needs</p>\n        <p style=\"margin: 0 0 16px 0; color: #334155; font-size: 14px; line-height: 1.5;\">{{ $json['Bussiness Details'].potential_need }}</p>\n      </div>\n\n      <div style=\"margin-top: 12px;\">\n        <p style=\"margin: 0 0 6px 0; font-size: 13px; font-weight: bold; color: #64748b; text-transform: uppercase;\">Outreach Strategy</p>\n        <p style=\"margin: 0; color: #334155; font-size: 14px; line-height: 1.5; background-color: #f0fdf4; padding: 10px; border-left: 4px solid #22c55e; border-radius: 4px;\">{{ $json['Bussiness Details'].outreach_angle }}</p>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- Footer -->\n  <div style=\"background-color: #f1f5f9; padding: 12px; text-align: center; font-size: 12px; color: #64748b; border-top: 1px solid #e2e8f0;\">\n    Automated Lead Analysis System • Sent via n8n Workflow\n  </div>\n\n</div>",
